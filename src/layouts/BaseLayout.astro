---
/**
 * 页面骨架：页眉、页脚、搜索面板、以及全站交互脚本。
 */
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import { withBase } from '../lib/url';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.subTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#f1efea" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={SITE.title} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    <div class="top-rule"></div>
    <Masthead />
    <main>
      <slot />
    </main>
    <Footer />
    <SearchPalette />

    <script>
      import { withBaseUrl } from '../lib/client';

      let globalsBound = false;

      function initGlobals() {
        if (globalsBound) return;
        globalsBound = true;

        const progress = document.querySelector<HTMLElement>('.post-progress');

        const onScroll = () => {
          if (!progress) return;
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          progress.style.transform = `scaleX(${ratio})`;
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        onScroll();

        document.addEventListener('keydown', (event) => {
          const isCmdK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
          const isSlash = event.key === '/' && !isTyping(event.target);
          if (isCmdK || isSlash) {
            event.preventDefault();
            // 页面上有胶囊搜索框就聚焦它，没有（比如文章页）才弹面板
            const inline = document.querySelector<HTMLInputElement>('[data-inline-input]');
            if (inline) {
              inline.focus();
              inline.select();
            } else {
              openSearch();
            }
          }
          if (event.key === 'Escape') closeSearch();
        });

        document.addEventListener('click', (event) => {
          const target = event.target as Element;
          if (target?.closest?.('[data-search-open]')) {
            event.preventDefault();
            openSearch();
          }
          if (target?.closest?.('[data-search-close]') || target?.classList?.contains('search-modal')) {
            closeSearch();
          }
        });
      }

      function isTyping(target: EventTarget | null): boolean {
        const el = target as HTMLElement | null;
        if (!el) return false;
        return /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName) || el.isContentEditable;
      }

      type SearchDoc = {
        title: string;
        description: string;
        url: string;
        tags: string[];
        date: string;
        text: string;
      };

      let searchIndex: SearchDoc[] | null = null;
      let activeIndex = 0;

      async function ensureIndex(): Promise<SearchDoc[]> {
        if (searchIndex) return searchIndex;
        try {
          const response = await fetch(withBaseUrl('search.json'));
          searchIndex = (await response.json()) as SearchDoc[];
        } catch {
          searchIndex = [];
        }
        return searchIndex;
      }

      async function openSearch() {
        const modal = document.getElementById('search-modal');
        const input = document.getElementById('search-input') as HTMLInputElement | null;
        if (!modal || !input) return;
        modal.classList.add('open');
        document.body.classList.add('modal-open');
        input.value = '';
        activeIndex = 0;
        renderResults((await ensureIndex()).slice(0, 8), '');
        requestAnimationFrame(() => input.focus());
      }

      function closeSearch() {
        const modal = document.getElementById('search-modal');
        if (!modal?.classList.contains('open')) return;
        modal.classList.remove('open');
        document.body.classList.remove('modal-open');
      }

      /** 统一清洗查询词：去掉开头的 #（这样 #web 和 web 都能搜到标签），转小写 */
      function normalizeQuery(raw: string): { q: string; tagOnly: boolean } {
        const trimmed = raw.trim();
        const tagOnly = trimmed.startsWith('#');
        return { q: (tagOnly ? trimmed.slice(1) : trimmed).toLowerCase(), tagOnly };
      }

      function score(doc: SearchDoc, query: string): number {
        const { q, tagOnly } = normalizeQuery(query);
        if (!q) return 0;
        const title = doc.title.toLowerCase();
        const tagHit = doc.tags.some((tag) => tag.toLowerCase().includes(q));
        if (tagOnly && !tagHit) return 0; // 写了 # 就只找标签
        if (title === q) return 100;
        if (title.startsWith(q)) return 80;
        if (title.includes(q)) return 60;
        if (tagHit) return 40;
        if (doc.description.toLowerCase().includes(q)) return 30;
        if (doc.text.toLowerCase().includes(q)) return 10;
        return 0;
      }

      function search(query: string): SearchDoc[] {
        const { q } = normalizeQuery(query);
        if (!q) return (searchIndex ?? []).slice(0, 8);
        return (searchIndex ?? [])
          .map((doc) => ({ doc, s: score(doc, query) }))
          .filter((item) => item.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 8)
          .map((item) => item.doc);
      }

      /** 从文章索引里汇总出所有标签 + 篇数 */
      function buildTagIndex(docs: SearchDoc[]): Map<string, number> {
        const map = new Map<string, number>();
        for (const doc of docs) {
          for (const tag of doc.tags) map.set(tag, (map.get(tag) ?? 0) + 1);
        }
        return map;
      }

      function escapeHtml(value: string): string {
        return value.replace(/[&<>"']/g, (char) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char,
        );
      }

      function renderResults(list: SearchDoc[], query: string) {
        const container = document.getElementById('search-results');
        if (!container) return;
        activeIndex = 0;
        if (list.length === 0) {
          container.innerHTML = `<div class="search-empty">没有找到和「${escapeHtml(query)}」相关的文章</div>`;
          return;
        }
        container.innerHTML = list
          .map(
            (doc, i) => `
            <a href="${doc.url}" data-index="${i}"${i === 0 ? ' class="active"' : ''}>
              <span class="r-no">${String(i + 1).padStart(2, '0')}</span>
              <span class="r-title">${escapeHtml(doc.title)}</span>
              <span class="r-desc">${escapeHtml(doc.tags[0] ?? '')}</span>
            </a>`,
          )
          .join('');
      }

      function moveActive(delta: number) {
        const links = [...document.querySelectorAll<HTMLAnchorElement>('#search-results a')];
        if (links.length === 0) return;
        links[activeIndex]?.classList.remove('active');
        activeIndex = (activeIndex + delta + links.length) % links.length;
        links[activeIndex]?.classList.add('active');
        links[activeIndex]?.scrollIntoView({ block: 'nearest' });
      }

      function bindSearchInput() {
        const input = document.getElementById('search-input') as HTMLInputElement | null;
        if (!input || input.dataset.bound === '1') return;
        input.dataset.bound = '1';
        input.addEventListener('input', () => {
          renderResults(search(input.value), input.value);
        });
        input.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            moveActive(1);
          } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            moveActive(-1);
          } else if (event.key === 'Enter') {
            const active = document.querySelector<HTMLAnchorElement>('#search-results a.active');
            if (active) {
              event.preventDefault();
              window.location.href = active.href;
            }
          }
        });
      }

      type InlineRow = { kind: 'tag' | 'note'; title: string; meta: string; href: string };

      /** 页内搜索框：输入即在下方出结果，支持 #标签 写法 */
      function initInlineSearch() {
        for (const root of document.querySelectorAll<HTMLElement>('[data-inline-search]')) {
          if (root.dataset.bound === '1') continue;
          root.dataset.bound = '1';

          const input = root.querySelector<HTMLInputElement>('[data-inline-input]');
          const drop = root.querySelector<HTMLElement>('[data-inline-drop]');
          if (!input || !drop) continue;

          let active = -1;

          const close = () => {
            drop.hidden = true;
            drop.innerHTML = '';
            active = -1;
          };

          const render = (list: InlineRow[], query: string) => {
            active = list.length > 0 ? 0 : -1;
            if (list.length === 0) {
              drop.innerHTML = `<div class="s-empty">没找到「${escapeHtml(query)}」相关的内容</div>`;
              drop.hidden = false;
              return;
            }
            drop.innerHTML = list
              .map(
                (row, i) => `
                <a href="${row.href}"${i === 0 ? ' class="active"' : ''}>
                  <span class="s-kind${row.kind === 'tag' ? ' tag' : ''}">${row.kind === 'tag' ? '标签' : '笔记'}</span>
                  <span class="s-title">${escapeHtml(row.title)}</span>
                  <span class="s-meta">${escapeHtml(row.meta)}</span>
                </a>`,
              )
              .join('');
            drop.hidden = false;
          };

          const run = async () => {
            const raw = input.value.trim();
            if (!raw) {
              close();
              return;
            }
            const docs = await ensureIndex();
            const { q, tagOnly } = normalizeQuery(raw);
            if (!q) {
              close();
              return;
            }

            const tagIndex = buildTagIndex(docs);
            const tagRows: InlineRow[] = [...tagIndex.entries()]
              .filter(([tag]) => tag.toLowerCase().includes(q))
              .sort((a, b) => b[1] - a[1])
              .slice(0, 6)
              .map(([tag, count]) => ({
                kind: 'tag',
                title: `#${tag}`,
                meta: `${count} 篇`,
                href: withBaseUrl(`tags/${encodeURIComponent(tag)}/`),
              }));

            const matched = tagOnly
              ? docs.filter((doc) => doc.tags.some((tag) => tag.toLowerCase().includes(q)))
              : docs
                  .map((doc) => ({ doc, s: score(doc, raw) }))
                  .filter((item) => item.s > 0)
                  .sort((a, b) => b.s - a.s)
                  .map((item) => item.doc);

            const noteRows: InlineRow[] = matched.slice(0, 8).map((doc) => ({
              kind: 'note',
              title: doc.title,
              meta: doc.tags[0] ?? '',
              href: doc.url,
            }));

            render([...tagRows, ...noteRows], raw);
          };

          input.addEventListener('input', run);
          input.addEventListener('focus', () => {
            if (input.value.trim()) void run();
          });
          input.addEventListener('keydown', (event) => {
            const links = [...drop.querySelectorAll<HTMLAnchorElement>('a')];
            if (event.key === 'Escape') {
              input.value = '';
              close();
              input.blur();
              return;
            }
            if (links.length === 0) return;
            if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
              event.preventDefault();
              const delta = event.key === 'ArrowDown' ? 1 : -1;
              links[active]?.classList.remove('active');
              active = (active + delta + links.length) % links.length;
              links[active]?.classList.add('active');
              links[active]?.scrollIntoView({ block: 'nearest' });
            } else if (event.key === 'Enter') {
              event.preventDefault();
              window.location.href = (links[active] ?? links[0]).href;
            }
          });

          document.addEventListener('click', (event) => {
            if (!root.contains(event.target as Node)) close();
          });
        }
      }

      function initPage() {
        bindSearchInput();
        initInlineSearch();

        for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
          if (pre.dataset.copy === '1') continue;
          pre.dataset.copy = '1';
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'copy-btn';
          button.textContent = '复制';
          button.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.textContent ?? '';
            try {
              await navigator.clipboard.writeText(code);
              button.textContent = '已复制';
              button.classList.add('done');
            } catch {
              button.textContent = '失败';
            }
            setTimeout(() => {
              button.textContent = '复制';
              button.classList.remove('done');
            }, 1600);
          });
          pre.appendChild(button);
        }

        const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.post-toc a')];
        if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
          const headings = tocLinks
            .map((link) => document.querySelector<HTMLElement>(decodeURIComponent(link.hash)))
            .filter((el): el is HTMLElement => Boolean(el));
          const tocObserver = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const id = `#${entry.target.id}`;
                tocLinks.forEach((link) => {
                  link.classList.toggle('active', decodeURIComponent(link.hash) === id);
                });
              }
            },
            { rootMargin: '-12% 0px -72% 0px' },
          );
          headings.forEach((heading) => tocObserver.observe(heading));
        }
      }

      document.addEventListener('astro:page-load', () => {
        initGlobals();
        initPage();
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initGlobals();
          initPage();
        });
      }
    </script>
  </body>
</html>
