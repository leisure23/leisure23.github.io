---
/** ⌘K 搜索面板：数据来自构建时生成的 /search.json */
import Icon from './Icon.astro';
---

<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章">
  <div class="search-panel">
    <div class="search-input-wrap">
      <Icon name="search" size={17} />
      <input
        id="search-input"
        type="search"
        placeholder="搜索标题、标签或正文…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索关键词"
      />
      <span class="kbd">Esc</span>
    </div>

    <div class="search-results" id="search-results"></div>

    <div class="search-hint">
      <span><span class="kbd">↑</span> <span class="kbd">↓</span> 选择</span>
      <span><span class="kbd">Enter</span> 打开</span>
      <span><span class="kbd">Esc</span> 关闭</span>
    </div>
  </div>
</div>
